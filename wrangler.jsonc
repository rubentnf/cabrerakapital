{
    "name": "cabrera-kapital",
    "main": "worker/index.js",
    "compatibility_date": "2025-09-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": [
            "/api/*"
        ]
    }
}