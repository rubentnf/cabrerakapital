---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
---

<Base
    title="Simulador de cuota · Cabrera Kapital"
    description="Calcule la cuota mensual orientativa de su hipoteca o préstamo."
    page="simulador"
>
    <section class="hero inner">
        <div class="deco" aria-hidden="true">
            <i class="d1"></i>
            <i class="d2"></i>
            <i class="d3"></i>
        </div>
        <div class="wrap">
            <span class="eyebrow" data-fade> Simulador </span>
            <h1 data-split>Calcule su cuota en segundos.</h1>
            <p class="lead" data-fade>
                Una estimación orientativa. El estudio real lo hacemos con sus
                datos y las condiciones de cada entidad.
            </p>
        </div>
    </section>
    <section class="sec">
        <div class="wrap simg" data-stag>
            <div class="card pad">
                <label>
                    Importe del préstamo <b id="vi"></b>
                    <input
                        type="range"
                        id="i"
                        min="30000"
                        max="800000"
                        step="5000"
                        value="200000"
                    />
                </label>
                <label>
                    Plazo <b id="vp"></b>
                    <input
                        type="range"
                        id="p"
                        min="5"
                        max="40"
                        step="1"
                        value="25"
                    />
                </label>
                <label>
                    Tipo de interés <b id="vt"></b>
                    <input
                        type="range"
                        id="t"
                        min="0.5"
                        max="8"
                        step="0.1"
                        value="3"
                    />
                </label>
            </div>
            <div class="card pad res">
                <span class="eyebrow">Cuota mensual estimada</span>
                <div class="huge" id="cuota">0 €</div>
                <div class="row2">
                    <span>Total a devolver</span>
                    <b id="tot"></b>
                </div>
                <div class="row2">
                    <span>Intereses</span>
                    <b id="int"></b>
                </div>
                <p class="small">
                    Cálculo orientativo; no constituye una oferta vinculante.
                </p>
                <a
                    class="btn gold"
                    style="align-self:flex-start"
                    href="/contacto/"
                >
                    Solicitar estudio real</a
                >
            </div>
        </div>
    </section>
    <Cta
        title="¿Le encaja? Lo estudiamos juntos."
        text="Sin coste ni compromiso."
        cta="Solicitar estudio gratuito"
        phone="Llamar 606 395 427"
    />
</Base>
