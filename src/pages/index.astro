---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Manifiesto from "../components/Manifiesto.astro";
import Oficina from "../components/Oficina.astro";
import Pasos from "../components/Pasos.astro";
import Editorial from "../components/Editorial.astro";
import Servicios from "../components/Servicios.astro";
import EntidadesSec from "../components/EntidadesSec.astro";
import Garantias from "../components/Garantias.astro";
import Cta from "../components/Cta.astro";
---

<Base
	title="Cabrera Kapital · Intermediación hipotecaria y financiación para
empresas en Canarias"
	description="Más de 20 años en la banca canaria, ahora de
su lado de la mesa. Estudio gratuito: solo cobramos si la operación se firma. La
Laguna, Tenerife."
>
	<Hero />
	<Manifiesto />
	<Oficina />
	<Pasos />
	<Editorial />
	<Servicios />
	<EntidadesSec />
	<Garantias />
	<Cta
		title="¿Hablamos de su caso?"
		text="El estudio inicial es gratuito y sin compromiso. Solo cobramos si la operación se firma."
		cta="Pedir estudio gratuito"
		phone="606 395 427"
	/>
</Base>
