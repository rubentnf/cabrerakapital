---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import HeroInterior from "../components/HeroInterior.astro";
import { langDe, ruta, useT } from "../i18n";
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
const s = t.simulador;
---

<Base title={s.title} description={s.description} page="simulador">
    <HeroInterior
        etiqueta={s.etiqueta}
        titulo={s.h1}
        lead={s.lead}
        ilustracion="/img/portada-simulador.svg"
    />
    <section class="sec">
        <div class="wrap simg" data-simulador data-stag data-lang={lang} data-anios={s.anios}>
            <div class="card pad">
                <label>
                    {s.importe}
                    <b data-out="importe"></b>
                    <input
                        type="range"
                        data-sim="importe"
                        min="30000"
                        max="800000"
                        step="5000"
                        value="200000"
                    />
                </label>
                <label>
                    {s.plazo}
                    <b data-out="plazo"></b>
                    <input
                        type="range"
                        data-sim="plazo"
                        min="5"
                        max="40"
                        step="1"
                        value="25"
                    />
                </label>
                <label>
                    {s.interes}
                    <b data-out="tipo"></b>
                    <input
                        type="range"
                        data-sim="tipo"
                        min="0.5"
                        max="8"
                        step="0.1"
                        value="3"
                    />
                </label>
            </div>
            <div class="card pad res">
                <span class="eyebrow">{s.cuota}</span>
                <div class="huge" data-out="cuota">0 €</div>
                <div class="row2">
                    <span>{s.total}</span>
                    <b data-out="total"></b>
                </div>
                <div class="row2">
                    <span>{s.intereses}</span>
                    <b data-out="intereses"></b>
                </div>
                <p class="small">{s.aviso}</p>
                <a
                    class="btn gold self-start"
                    href={ruta("contacto", lang)}
                >
                    {s.boton}
                </a>
            </div>
        </div>
    </section>
    <Cta
        title={s.ctaTitulo}
        text={s.ctaTexto}
        cta={s.ctaBoton}
    />
</Base>
