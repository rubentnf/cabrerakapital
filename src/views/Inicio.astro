---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Manifiesto from "../components/Manifiesto.astro";
import Oficina from "../components/Oficina.astro";
import Pasos from "../components/Pasos.astro";
import Editorial from "../components/Editorial.astro";
import Servicios from "../components/Servicios.astro";
import EntidadesSec from "../components/EntidadesSec.astro";
import Garantias from "../components/Garantias.astro";
import Cta from "../components/Cta.astro";
import { langDe, useT } from "../i18n";
import Caminos from "../components/Caminos.astro";
import Resenas from "../components/Resenas.astro";
const t = useT(langDe(Astro.url.pathname)).inicio;
---

<Base title={t.title} description={t.description} page="inicio">
    <Hero />
    <Manifiesto />
    <Oficina />
    <Pasos />
    <Editorial />
    <Caminos />
    <Servicios />
    <EntidadesSec />
    <Garantias />
    <Resenas />
    <Cta
        title={t.cta.titulo}
        text={t.cta.texto}
        cta={t.cta.boton}
    />
</Base>
