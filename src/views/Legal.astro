---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import { rutaLegal, slugs, type DocumentoId } from "../data/legal";
import { langDe, ruta, useT } from "../i18n";

interface Props {
    id: DocumentoId;
}
const { id } = Astro.props;
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
const titulo = t.documentos[id];

// El texto de cada documento está en src/legal/<slug>.md y su traducción en src/legal/en/<slug>.md
// (si faltara la traducción, se muestra el texto en español)
type Documento = {
    Content: any;
    getHeadings: () => { depth: number; slug: string; text: string }[];
};
const archivos = import.meta.glob<Documento>("../legal/*.md", { eager: true });
const traducciones = import.meta.glob<Documento>("../legal/en/*.md", { eager: true });
const traducido = lang === "en" ? traducciones[`../legal/en/${slugs[id]}.md`] : undefined;
const { Content, getHeadings } = traducido ?? archivos[`../legal/${slugs[id]}.md`];

// Índice lateral: los títulos de apartado (## …) del documento
const indice = getHeadings().filter((h) => h.depth === 2);

// Botón «Descargar PDF»: solo aparece si el archivo existe en public/legal/<slug>.pdf
// (en inglés, public/legal/en/<slug>.pdf; si no existe, el PDF en español)
const rutaPdf = (carpeta: string) =>
    existsSync(join(process.cwd(), "public", carpeta, `${slugs[id]}.pdf`))
        ? `/${carpeta}/${slugs[id]}.pdf`
        : null;
const pdfTraducido = traducido ? rutaPdf("legal/en") : null;
const pdf = pdfTraducido ?? rutaPdf("legal");
---

<!-- page="faq": ninguna pestaña del menú queda marcada en las páginas legales -->
<Base
    title={`${titulo} · Cabrera Kapital`}
    description={t.documentos.descripcion.replace("{titulo}", titulo)}
    page="faq"
    alt={{ es: rutaLegal(id, "es"), en: rutaLegal(id, "en") }}
>
    <section class="sec legal">
        <div class="wrap">
            <p class="legal-volver">
                <a href={ruta("inicio", lang)}>← {t.documentos.volver}</a>
            </p>
            <h1 class="legal-titulo">{titulo}</h1>
            {
                lang === "en" && (
                    <p class="note">
                        {traducido ? t.documentos.traduccion : t.documentos.soloEs}
                    </p>
                )
            }
            {
                pdf && (
                    <p>
                        <a
                            class="btn legal-pdf"
                            href={pdf}
                            target="_blank"
                            rel="noopener"
                        >
                            {pdfTraducido || lang === "es" ? t.documentos.descargar : t.documentos.descargarEs}
                        </a>
                    </p>
                )
            }
            <div class="legal-grid">
                {
                    indice.length > 1 && (
                        <nav class="legal-toc" aria-label={t.documentos.indice}>
                            <p class="legal-toc-t">{t.documentos.indice}</p>
                            <ol>
                                {indice.map((h) => (
                                    <li>
                                        <a href={`#${h.slug}`}>
                                            {h.text.replace(/^\d+\.\s*/, "")}
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        </nav>
                    )
                }
                <article class="legal-texto">
                    <Content />
                </article>
            </div>
        </div>
    </section>
</Base>
