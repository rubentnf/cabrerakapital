---
// Un recorrido del simulador (comprar o mejorar): sus pasos (<Paso>) con todas las preguntas.
// Siempre oculto: scripts/simulador.ts hace las preguntas en forma de conversación, guarda aquí las
// respuestas y lo envía igual que el formulario de contacto. `valor` aparece en el correo como «Simulador».
import { contacto } from "../../data/contacto";
import { langDe, useT } from "../../i18n";

interface Props {
    flujo: "comprar" | "mejorar";
    valor: string;
}
const { flujo, valor } = Astro.props;
const t = useT(langDe(Astro.url.pathname));
const c = t.contacto;
const tels = contacto.telefonos.map((p) => p.visible).join(` ${c.errorO} `);
---

<form
    class="sim-form"
    data-flujo={flujo}
    hidden
    novalidate
    data-error={`${c.error} ${tels}.`}
>
    <input type="hidden" name="tipo_cliente" value="particular" />
    <input type="hidden" name="flujo" value={valor} />
    <input
        type="text"
        name="_gotcha"
        class="hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
    />
    <slot />
</form>
