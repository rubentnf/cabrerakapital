---
// Foto con hueco: si existe src/assets/photos/<name>.(jpg|jpeg|png|webp|avif) se muestra optimizada;
// si no, se muestra el contenido de reserva (la ilustración).
import { Image } from "astro:assets";
import { fotos } from "../utils/assets";

interface Props {
    name: string;
    alt: string;
    widths?: number[];
    sizes?: string;
    loading?: "lazy" | "eager";
}

const {
    name,
    alt,
    widths = [480, 800, 1200, 1600],
    sizes = "100vw",
    loading = "lazy",
} = Astro.props;

const img = fotos.get(name);
---

{
    img ? (
        <Image
            src={img}
            alt={alt}
            widths={widths}
            sizes={sizes}
            loading={loading}
            class="foto"
        />
    ) : (
        <slot />
    )
}
