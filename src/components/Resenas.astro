---
// Opiniones de clientes. Las reseñas y la nota llegan de Google (scripts/resenas.ts → /api/resenas)
// o de la lista manual de data/resenas.ts, según `modo`. Sin reseñas, la sección no se muestra.
import { google, modo, resenas } from "../data/resenas";
import { langDe, useT } from "../i18n";
const lang = langDe(Astro.url.pathname);
const t = useT(lang).resenas;
const inicial = (n: string) =>
    n
        .replace(/[^\p{L}]/gu, "")
        .charAt(0)
        .toUpperCase() || "·";
---

<section
    class="sec alt"
    aria-labelledby="opiniones-t"
    data-resenas={modo}
    data-lang={lang}
    data-texto-google={t.google}
    data-leer-mas={t.leerMas}
    data-leer-menos={t.leerMenos}
    hidden={resenas.length === 0}
>
    <div class="wrap" data-carrusel>
        <div class="shead">
            <div>
                <span class="eyebrow dk">{t.etiqueta}</span>
                <h2 id="opiniones-t" data-rise>
                    {t.titulo}
                </h2>
                <p class="opin-nota" data-nota hidden={google.puntuacion === null}>
                    <b data-puntuacion>{google.puntuacion?.toFixed(1)}</b>
                    <span class="stars" aria-hidden="true">★★★★★</span>
                    <span data-total hidden={google.total === null}>
                        · <span data-total-n>{google.total}</span> {t.valoracion}
                    </span>
                </p>
            </div>
            <div class="opin-nav">
                <button type="button" data-prev aria-label={t.anterior}>←</button>
                <button type="button" data-next aria-label={t.siguiente}>→</button>
            </div>
        </div>
        <ul class="opin-pista" data-pista tabindex="0">
            {
                resenas.map((r) => (
                    <li class="card opin">
                        <span class="stars" role="img" aria-label={`${r.estrellas} / 5`}>
                            {"★".repeat(r.estrellas)}
                        </span>
                        <p class="opin-t">{r.texto}</p>
                        <div class="opin-quien">
                            <span class="opin-av" aria-hidden="true">
                                {inicial(r.nombre)}
                            </span>
                            <div>
                                <b>{r.nombre}</b>
                                <small>
                                    {t.google}
                                    {r.fecha ? ` · ${r.fecha}` : ""}
                                </small>
                            </div>
                        </div>
                    </li>
                ))
            }
        </ul>
        <p class="note">
            <a href={google.enlace} target="_blank" rel="noopener noreferrer" data-enlace>
                {t.ver}
            </a>
        </p>
    </div>
</section>
