---
import Foto from "./Foto.astro";
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.oficina;
---

<section class="revimg" aria-labelledby="office-title">
    <div class="frame" id="frame">
        <div class="frame-inner" id="frame-inner" aria-hidden="true">
            <Foto
                name="oficina"
                alt="Fachada de la oficina de Cabrera Kapital en La Laguna"
            >
                <img
                    class="foto"
                    src="/img/scene-catedral.svg"
                    alt=""
                    width="1600"
                    height="900"
                    loading="lazy"
                    decoding="async"
                />
            </Foto>
        </div>
        <div class="frame-cap">
            <h2 id="office-title">{t.titulo}</h2>
            <span class="chip">{t.chip}</span>
        </div>
    </div>
</section>
