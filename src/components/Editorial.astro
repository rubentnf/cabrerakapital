---
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.editorial;
---

<section class="edit" id="edit">
    <div class="wrap">
        <div class="edit-l">
            <ul class="edit-list" aria-hidden="true">
                {
                    t.lista.map((x, i) => (
                        <li class={i === 0 ? "on" : undefined}>{x}</li>
                    ))
                }
            </ul>
            <h2>
                <span class="ln">
                    <span>{t.l1}</span>
                </span>
                <span class="ln">
                    <span>{t.l2}</span>
                </span>
                <span class="ln">
                    <span>
                        <em>{t.l3}</em>
                    </span>
                </span>
            </h2>
            <p class="edit-sub">{t.sub}</p>
        </div>
        <div class="edit-r" aria-hidden="true">
            <img class="fi b" src="/img/editorial-comparar.svg" alt="" width="800" height="600" loading="lazy" data-speed="40" />
            <img class="fi a" src="/img/editorial-firmar.svg" alt="" width="600" height="600" loading="lazy" data-speed="-30" />
            <img class="fi c" src="/img/editorial-balanza.svg" alt="" width="600" height="600" loading="lazy" data-speed="-60" />
        </div>
    </div>
</section>
