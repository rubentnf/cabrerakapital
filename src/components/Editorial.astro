---
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.editorial;
---

<section class="edit" id="edit">
    <div class="wrap">
        <div class="edit-l">
            <ul class="edit-list" aria-hidden="true">
                {
                    t.lista.map((x, i) => (
                        <li class={i === 0 ? "on" : undefined}>{x}</li>
                    ))
                }
            </ul>
            <h2>
                <span class="ln">
                    <span>{t.l1}</span>
                </span>
                <span class="ln">
                    <span>{t.l2}</span>
                </span>
                <span class="ln">
                    <em>{t.l3}</em>
                </span>
            </h2>
            <p class="edit-sub">{t.sub}</p>
        </div>
        <div class="edit-r">
            <i class="fi b" data-speed="50" style="--img:var(--s3)"></i>
            <i class="fi a" data-speed="-40" style="--img:var(--s2)"></i>
            <i class="fi c" data-speed="-70" style="--img:var(--s1)"></i>
        </div>
    </div>
</section>
