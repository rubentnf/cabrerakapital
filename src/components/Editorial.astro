---
import { Image } from "astro:assets";
import { langDe, useT } from "../i18n";
import entidades from "../assets/photos/entidades-financieras.jpg";
import apreton from "../assets/photos/apreton-manos.jpg";
const t = useT(langDe(Astro.url.pathname)).inicio.editorial;
---

<section class="edit" id="edit">
    <div class="wrap">
        <div class="edit-l">
            <ul class="edit-list" aria-hidden="true">
                {
                    t.lista.map((x, i) => (
                        <li class={i === 0 ? "on" : undefined}>{x}</li>
                    ))
                }
            </ul>
            <h2>
                <span class="ln">
                    <span>{t.l1}</span>
                </span>
                <span class="ln">
                    <span>{t.l2}</span>
                </span>
                <span class="ln">
                    <span>
                        <em>{t.l3}</em>
                    </span>
                </span>
            </h2>
            <p class="edit-sub">{t.sub}</p>
        </div>
        <div class="edit-r">
            <div class="fi b" data-speed="50">
                <Image
                    src={entidades}
                    alt={t.altEntidades}
                    widths={[480, 800, 1200]}
                    sizes="(max-width: 767px) 100vw, 40vw"
                    loading="lazy"
                />
            </div>
            <div class="fi a" data-speed="-40">
                <Image
                    src={apreton}
                    alt={t.altApreton}
                    widths={[300, 480, 700]}
                    sizes="(max-width: 767px) 0px, 18vw"
                    loading="lazy"
                />
            </div>
            <i
                class="fi c"
                data-speed="-70"
                style="--img:url('/img/comparar-escudo.svg')"
                aria-hidden="true"></i>
        </div>
    </div>
</section>
