---
import Entidades from "./Entidades.astro";
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.entidades;
---

<section class="sec alt">
    <div class="wrap center-ents">
        <span class="eyebrow dk">{t.etiqueta}</span>
        <h2 data-rise class="mb-32">
            {t.titulo}
        </h2>
        <Entidades />
    </div>
</section>
