---
import { fondos } from "../data/servicios";
import { langDe, useT } from "../i18n";
const { filas } = useT(langDe(Astro.url.pathname));
---

<ul class="rows" data-rows>
    {
        filas.map((f, i) => (
            <li class={i === 0 ? "row active" : "row"}>
                <i class="rbg" style={`--img:url('${fondos[i]}')`} />
                <p class="rd">
                    <i>{i + 1}</i>
                    <span>{f.texto}</span>
                </p>
                <span class="rt">
                    <span>
                        {f.verbo}
                        <em>{f.resto}</em>
                    </span>
                </span>
            </li>
        ))
    }
</ul>
