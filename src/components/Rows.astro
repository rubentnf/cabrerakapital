---
import { escenas } from "../data/servicios";
import { langDe, useT } from "../i18n";
const { filas } = useT(langDe(Astro.url.pathname));
---

<ul class="rows" data-rows>
    {
        filas.map((f, i) => (
            <li class="row">
                <i class="rbg" style={`--img:var(--${escenas[i]})`} />
                <p class="rd">
                    <i>{i + 1}</i>
                    <span>{f.texto}</span>
                </p>
                <span class="rt">
                    <span>
                        {f.verbo}
                        <em>{f.resto}</em>
                    </span>
                </span>
                <svg
                    class="ra"
                    viewBox="0 0 56 56"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M10 28h34M30 12l16 16-16 16" />
                </svg>
            </li>
        ))
    }
</ul>
