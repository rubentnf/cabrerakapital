---
interface Props {
    etiqueta: string;
    titulo: string;
    lead: string;
}
const { etiqueta, titulo, lead } = Astro.props;
---

<section class="hero inner">
    <div class="deco" aria-hidden="true">
        <i class="d1"></i>
        <i class="d2"></i>
        <i class="d3"></i>
    </div>
    <div class="wrap">
        <span class="eyebrow" data-fade>
            {etiqueta}
        </span>
        <h1 data-split>{titulo}</h1>
        <p class="lead" data-fade>
            {lead}
        </p>
    </div>
</section>
