---
interface Props {
    etiqueta: string;
    titulo: string;
    lead: string;
    /** Ilustración de la derecha (public/img/portada-*.svg). Sin ella se muestran las formas decorativas. */
    ilustracion?: string;
    /** false: sin ilustración ni formas decorativas, solo el fondo azul (por ejemplo «Equipo»). */
    decoracion?: boolean;
}
const { etiqueta, titulo, lead, ilustracion, decoracion = true } = Astro.props;
---

<section class="hero inner">
    {
        ilustracion ? (
            <div class="hero-ilus" aria-hidden="true">
                <img
                    src={ilustracion}
                    alt=""
                    width="600"
                    height="500"
                    decoding="async"
                />
            </div>
        ) : decoracion && (
            <div class="deco" aria-hidden="true">
                <i class="d1" />
                <i class="d2" />
                <i class="d3" />
            </div>
        )
    }
    <div class="wrap">
        <span class="eyebrow" data-fade>
            {etiqueta}
        </span>
        <h1 data-split>{titulo}</h1>
        <p class="lead" data-fade>
            {lead}
        </p>
        <slot />
    </div>
</section>
