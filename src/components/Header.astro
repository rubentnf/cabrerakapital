---
import { langDe, ruta, useT, type PaginaId } from "../i18n";
import { Image } from "astro:assets";
import logo from "../assets/logo/ck-simbolo.png";
import LangSwitch from "./LangSwitch.astro";

interface Props {
    page?: PaginaId;
    alts: { es: string; en: string };
}
const { page, alts } = Astro.props;
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
const ids: (keyof typeof t.nav)[] = [
    "inicio",
    "servicios",
    "equipo",
    "porque",
    "simulador",
    "contacto",
];
const nav = ids.map((id) => ({ id, label: t.nav[id], href: ruta(id, lang) }));
---

<header class="nav" id="nav">
    <div class="wrap">
        <a
            class="brand"
            href={ruta("inicio", lang)}
            aria-label={t.header.inicio}
        >
            <Image
                class="logo-img"
                src={logo}
                alt=""
                width={44}
                height={44}
                loading="eager"
            />Cabrera Kapital
        </a>
        <nav class="links" aria-label={t.header.principal}>
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        aria-current={n.id === page ? "page" : undefined}
                    >
                        {n.label}
                    </a>
                ))
            }
        </nav>
        <div class="navr">
            <LangSwitch alts={alts} />
            <button
                class="tema"
                type="button"
                data-tema
                aria-pressed="false"
                aria-label={t.header.tema}
                title={t.header.tema}
            >
                <svg class="tema-luna" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1Z"></path>
                </svg>
                <svg class="tema-sol" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
                    <path stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
                </svg>
            </button>
            <a class="btn gold" href={ruta("contacto", lang)}>
                {t.header.cta}
            </a>
            <button
                class="burger"
                id="burger"
                aria-label={t.header.abrirMenu}
                aria-expanded="false"
                aria-controls="menu"
                data-abrir={t.header.abrirMenu}
                data-cerrar={t.header.cerrarMenu}
            >
                <i></i>
                <i></i>
                <i></i>
            </button>
        </div>
    </div>
</header>
<div class="menu" id="menu">
    {
        nav.map((n) => (
            <a href={n.href} aria-current={n.id === page ? "page" : undefined}>
                {n.label}
            </a>
        ))
    }
    <a
        class="btn gold"
        href={ruta("contacto", lang)}
        style="font:700 15px var(--sans);border:0;text-align:center"
    >
        {t.header.cta}
    </a>
    <LangSwitch alts={alts} />
</div>
