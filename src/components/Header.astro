---
import { langDe, ruta, useT, type PaginaId } from "../i18n";
import { Image } from "astro:assets";
import logo from "../assets/logo/ck-simbolo.png";
import LangSwitch from "./LangSwitch.astro";
import IconoInstagram from "./IconoInstagram.astro";
import Luna from "../assets/svg/luna.svg";
import Sol from "../assets/svg/sol.svg";
import { contacto } from "../data/contacto";

interface Props {
    page?: PaginaId;
    alts: { es: string; en: string };
}
const { page, alts } = Astro.props;
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
const ids: (keyof typeof t.nav)[] = [
    "inicio",
    "servicios",
    "equipo",
    "porque",
    "simulador",
    "contacto",
];
const nav = ids.map((id) => ({ id, label: t.nav[id], href: ruta(id, lang) }));
---

<header class="nav" id="nav">
    <div class="wrap">
        <a
            class="brand"
            href={ruta("inicio", lang)}
            aria-label={t.header.inicio}
        >
            <Image
                class="logo-img"
                src={logo}
                alt=""
                width={44}
                height={44}
                densities={[1, 2]}
                loading="eager"
            />Cabrera Kapital
        </a>
        <nav class="links" aria-label={t.header.principal}>
            {
                nav.map((n) => (
                    <a
                        href={n.href}
                        aria-current={n.id === page ? "page" : undefined}
                    >
                        {/* Texto que «rueda» al pasar el ratón (CSS .rl): la copia es solo visual */}
                        <span class="rl">
                            <span>{n.label}</span>
                            <span aria-hidden="true">{n.label}</span>
                        </span>
                    </a>
                ))
            }
        </nav>
        <div class="navr">
            <LangSwitch alts={alts} />
            <button
                class="tema"
                type="button"
                data-tema
                aria-pressed="false"
                aria-label={t.header.tema}
                title={t.header.tema}
            >
                <Luna class="tema-luna" width="20" height="20" aria-hidden="true" />
                <Sol class="tema-sol" width="20" height="20" aria-hidden="true" />
            </button>
            <!-- Instagram a la vista en todas las páginas (en móvil va en el menú, con texto) -->
            <a
                class="tema ig-nav"
                href={contacto.instagram.enlace}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${t.header.instagram} ${contacto.instagram.usuario}`}
                title={`${t.header.instagram} ${contacto.instagram.usuario}`}
            >
                <IconoInstagram tamano={19} />
            </a>
            <a class="btn gold" href={ruta("contacto", lang)}>
                {t.header.cta}
            </a>
            <button
                class="burger"
                id="burger"
                aria-label={t.header.abrirMenu}
                aria-expanded="false"
                aria-controls="menu"
                data-abrir={t.header.abrirMenu}
                data-cerrar={t.header.cerrarMenu}
            >
                <i></i>
                <i></i>
                <i></i>
            </button>
        </div>
    </div>
</header>
<div class="menu" id="menu">
    {
        nav.map((n) => (
            <a href={n.href} aria-current={n.id === page ? "page" : undefined}>
                {n.label}
            </a>
        ))
    }
    <a
        class="btn gold"
        href={ruta("contacto", lang)}
        style="font:700 15px var(--sans);border:0;text-align:center"
    >
        {t.header.cta}
    </a>
    <a
        class="menu-ig"
        href={contacto.instagram.enlace}
        target="_blank"
        rel="noopener noreferrer"
    >
        <IconoInstagram tamano={22} />
        <span>{t.header.instagram} · <b>{contacto.instagram.usuario}</b></span>
    </a>
</div>
