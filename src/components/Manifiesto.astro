---
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.manifiesto;
---

<section class="manif" aria-labelledby="mlabel">
    <div class="wrap">
        <span class="eyebrow dk mob" id="mlabel">
            {t.etiqueta}
        </span>
        <p class="manif-t mob" data-words>
            {t.texto}
        </p>
        <div class="mstats" data-stag>
            <div>
                <b>
                    <span data-count="20">20</span>+
                </b>
                <span>{t.anios}</span>
            </div>
            <div>
                <b>E593</b>
                <span>{t.registro}</span>
            </div>
            <div>
                <b>
                    <span data-count="24">24</span>-<span data-count="48"
                        >48</span
                    > h
                </b>
                <span>{t.respuesta}</span>
            </div>
            <div>
                <b>
                    <span data-count="0">0</span> €
                </b>
                <span>{t.coste}</span>
            </div>
        </div>
    </div>
</section>
