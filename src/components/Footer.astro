---
import { Image } from "astro:assets";
import logo from "../assets/logo/ck-simbolo.png";
import { contacto } from "../data/contacto";
import { grupoInformacion, grupoLegal, rutaLegal } from "../data/legal";
import { langDe, ruta, useT } from "../i18n";

const lang = langDe(Astro.url.pathname);
const t = useT(lang);
---

<footer class="foot">
    <div class="wrap">
        <div class="fgrid">
            <div class="fmarca">
                <Image
                    class="foot-logo"
                    src={logo}
                    alt="Cabrera Kapital"
                    width={64}
                    height={64}
                />
                <div>{t.footer.descripcion}</div>
            </div>
            <div>
                <h2>{t.footer.contacto}</h2>
                {
                    contacto.telefonos.map((p) => (
                        <div>
                            <a href={`tel:${p.tel}`}>{p.visible}</a>
                        </div>
                    ))
                }
                <div>
                    <a href={`mailto:${contacto.correo}`}>{contacto.correo}</a>
                </div>
                <div>{contacto.direccionCorta}</div>
            </div>
            <div>
                <h2>{t.footer.info}</h2>
                {
                    grupoInformacion.map((id) => (
                        <div>
                            <a href={rutaLegal(id, lang)}>{t.documentos[id]}</a>
                        </div>
                    ))
                }
                <div>
                    <a href={ruta("faq", lang)}>{t.documentos.faq}</a>
                </div>
            </div>
            <div>
                <h2>{t.footer.legal}</h2>
                {
                    grupoLegal.map((id) => (
                        <div>
                            <a href={rutaLegal(id, lang)}>{t.documentos[id]}</a>
                        </div>
                    ))
                }
                <div>
                    <a href={rutaLegal("cookies", lang)} data-cookies-abrir>
                        {t.cookies.configurar}
                    </a>
                </div>
            </div>
            <div>
                <h2>{t.footer.registro}</h2>
                <div>{t.footer.inscrita}</div>
                <div>{t.footer.titular}</div>
            </div>
        </div>
        <div class="fbot">
            <span>© Cabrera Kapital</span>
        </div>
    </div>
</footer>
