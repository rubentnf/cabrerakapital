---
import { contacto } from "../data/contacto";
import { grupoInformacion, grupoLegal, rutaLegal } from "../data/legal";
import { langDe, ruta, useT } from "../i18n";

const lang = langDe(Astro.url.pathname);
const t = useT(lang);
---

<footer class="foot">
    <div class="wrap">
        <div class="fgrid">
            <div>
                <div class="fb">Cabrera Kapital</div>
                <div>{t.footer.descripcion}</div>
            </div>
            <div>
                <h4>{t.footer.contacto}</h4>
                {
                    contacto.telefonos.map((p) => (
                        <div>
                            <a href={`tel:${p.tel}`}>{p.visible}</a>
                        </div>
                    ))
                }
                <div>
                    <a href={`mailto:${contacto.correo}`}>{contacto.correo}</a>
                </div>
                <div>{contacto.direccionCorta}</div>
            </div>
            <div>
                <h4>{t.footer.info}</h4>
                {
                    grupoInformacion.map((id) => (
                        <div>
                            <a href={rutaLegal(id, lang)}>{t.documentos[id]}</a>
                        </div>
                    ))
                }
                <div>
                    <a href={ruta("faq", lang)}>{t.documentos.faq}</a>
                </div>
            </div>
            <div>
                <h4>{t.footer.legal}</h4>
                {
                    grupoLegal.map((id) => (
                        <div>
                            <a href={rutaLegal(id, lang)}>{t.documentos[id]}</a>
                        </div>
                    ))
                }
            </div>
            <div>
                <h4>{t.footer.registro}</h4>
                <div>{t.footer.inscrita}</div>
                <div>{t.footer.titular}</div>
            </div>
        </div>
        <div class="bigwm" aria-hidden="true">
            <b>CABRERA KAPITAL</b>
        </div>
        <div class="fbot">© Cabrera Kapital</div>
    </div>
</footer>
