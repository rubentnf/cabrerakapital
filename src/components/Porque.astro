---
import { langDe, useT } from "../i18n";
const { motivos } = useT(langDe(Astro.url.pathname));
---

<div class="grid4" data-why>
    {
        motivos.map((m, i) => (
            <article class="card">
                <span class="num" style="font-size:44px">
                    0{i + 1}
                </span>
                <h3>{m.t}</h3>
                <p>{m.d}</p>
            </article>
        ))
    }
</div>
