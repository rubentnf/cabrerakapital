---
import { langDe, useT } from "../i18n";
import BanderaEs from "../assets/svg/bandera-es.svg";
import BanderaEn from "../assets/svg/bandera-en.svg";

interface Props {
    alts: { es: string; en: string };
}
const { alts } = Astro.props;
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
---

<div class="lang" role="group" aria-label={t.idioma.cambiar}>
    <a
        href={alts.es}
        hreflang="es"
        lang="es"
        title={t.idioma.es}
        aria-label={t.idioma.es}
        aria-current={lang === "es" ? "true" : undefined}
    >
        <BanderaEs width="26" height="17" aria-hidden="true" />
    </a>
    <a
        href={alts.en}
        hreflang="en"
        lang="en"
        title={t.idioma.en}
        aria-label={t.idioma.en}
        aria-current={lang === "en" ? "true" : undefined}
    >
        <BanderaEn width="26" height="17" aria-hidden="true" />
    </a>
</div>
