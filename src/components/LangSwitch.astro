---
import { langDe, ruta, useT, type PaginaId } from "../i18n";

interface Props {
    page?: PaginaId;
    alt?: { es: string; en: string };
}
const { page = "inicio", alt } = Astro.props;
const lang = langDe(Astro.url.pathname);
const t = useT(lang);
---

<div class="lang" role="group" aria-label={t.idioma.cambiar}>
    <a
        href={alt?.es ?? ruta(page, "es")}
        hreflang="es"
        lang="es"
        title={t.idioma.es}
        aria-label={t.idioma.es}
        aria-current={lang === "es" ? "true" : undefined}
    >
        <svg viewBox="0 0 30 20" width="26" height="17" aria-hidden="true">
            <rect width="30" height="20" fill="#c60b1e"></rect>
            <rect y="5" width="30" height="10" fill="#ffc400"></rect>
        </svg>
    </a>
    <a
        href={alt?.en ?? ruta(page, "en")}
        hreflang="en"
        lang="en"
        title={t.idioma.en}
        aria-label={t.idioma.en}
        aria-current={lang === "en" ? "true" : undefined}
    >
        <svg viewBox="0 0 60 40" width="26" height="17" aria-hidden="true">
            <rect width="60" height="40" fill="#012169"></rect>
            <path d="M0 0 60 40M60 0 0 40" stroke="#fff" stroke-width="8"
            ></path>
            <path d="M0 0 60 40M60 0 0 40" stroke="#c8102e" stroke-width="3"
            ></path>
            <path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="12"></path>
            <path d="M30 0v40M0 20h60" stroke="#c8102e" stroke-width="7"></path>
        </svg>
    </a>
</div>
