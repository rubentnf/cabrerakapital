---
interface Props {
    tamano?: number;
}
const { tamano = 18 } = Astro.props;
---

<svg
    class="ico-ig"
    viewBox="0 0 24 24"
    width={tamano}
    height={tamano}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
>
    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
    <circle cx="12" cy="12" r="4"></circle>
    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"></circle>
</svg>
