---
import { contacto } from "../data/contacto";
import { langDe, useT } from "../i18n";

const t = useT(langDe(Astro.url.pathname));
const href = `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(t.whatsapp.mensaje)}`;
---

<a
    class="wa"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.whatsapp.etiqueta}
    title={t.whatsapp.etiqueta}
>
    <svg
        viewBox="0 0 32 32"
        width="30"
        height="30"
        aria-hidden="true"
        fill="currentColor"
    >
        <path
            d="M16.02 3C8.84 3 3 8.83 3 16c0 2.29.6 4.53 1.74 6.5L3 29l6.68-1.72A13 13 0 0 0 16.02 29C23.18 29 29 23.17 29 16S23.18 3 16.02 3Zm0 23.8c-1.95 0-3.85-.53-5.5-1.52l-.4-.23-3.97 1.02 1.06-3.86-.26-.4A10.76 10.76 0 0 1 5.2 16c0-5.96 4.86-10.8 10.82-10.8 5.96 0 10.8 4.84 10.8 10.8s-4.85 10.8-10.8 10.8Zm5.93-8.08c-.32-.16-1.92-.95-2.22-1.05-.3-.11-.51-.16-.73.16-.22.32-.84 1.05-1.03 1.27-.19.22-.38.24-.7.08-.33-.16-1.37-.5-2.6-1.6a9.7 9.7 0 0 1-1.8-2.24c-.19-.33-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.22-.33.33-.54.1-.22.05-.4-.03-.57-.08-.16-.73-1.77-1-2.42-.26-.63-.53-.54-.73-.55h-.62c-.22 0-.57.08-.87.4-.3.32-1.14 1.11-1.14 2.72s1.17 3.16 1.33 3.38c.16.22 2.3 3.5 5.57 4.91.78.34 1.38.54 1.86.69.78.25 1.49.21 2.05.13.63-.09 1.92-.78 2.19-1.54.27-.76.27-1.4.19-1.54-.08-.14-.3-.22-.62-.38Z"
        ></path>
    </svg>
</a>
