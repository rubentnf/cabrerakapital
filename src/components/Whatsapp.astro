---
import IconoWhatsapp from "../assets/svg/whatsapp.svg";
import { contacto } from "../data/contacto";
import { langDe, useT } from "../i18n";

const t = useT(langDe(Astro.url.pathname));
const href = `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(t.whatsapp.mensaje)}`;
---

<a
    class="wa"
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={t.whatsapp.etiqueta}
    title={t.whatsapp.etiqueta}
>
    <IconoWhatsapp width="30" height="30" aria-hidden="true" />
</a>
