---
import { Image } from "astro:assets";
import { langDe, useT } from "../i18n";
import bde from "../assets/sellos/banco-de-espana.png";
import efpa from "../assets/sellos/efpa.png";
import lcci from "../assets/sellos/lcci.png";
const t = useT(langDe(Astro.url.pathname)).inicio.garantias;
// Mismo orden que t.sellos: Banco de España, EFPA, LCCI
const logos = [bde, efpa, lcci];
---

<section class="sec">
    <div class="wrap garant">
        <div>
            <span class="eyebrow dk">{t.etiqueta}</span>
            <h2 data-rise>{t.titulo}</h2>
            <p data-rise>{t.texto}</p>
        </div>
        <div class="seals" data-stag>
            {
                t.sellos.map(([b, s], i) => (
                    <div class={i === 0 ? "seal wide" : "seal"}>
                        <Image
                            src={logos[i]}
                            alt={`${b} · ${s}`}
                            widths={[240, 480]}
                            sizes="(max-width: 767px) 80vw, 280px"
                            loading="lazy"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>
