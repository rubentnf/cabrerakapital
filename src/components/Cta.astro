---
interface Props {
    title: string;
    text: string;
    cta: string;
    phone: string;
}
const { title, text, cta, phone } = Astro.props;
---

<section class="cta">
    <div class="wrap">
        <div>
            <h2>{title}</h2>
            <p>{text}</p>
        </div>
        <div class="btns" style="margin:0">
            <a class="btn gold" href="/contacto/"> {cta}</a>
            <a class="btn line" href="tel:+34606395427">
                {phone}
            </a>
        </div>
    </div>
</section>
