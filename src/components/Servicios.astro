---
import Rows from "./Rows.astro";
import { langDe, ruta, useT } from "../i18n";
const lang = langDe(Astro.url.pathname);
const t = useT(lang).inicio.servicios;
---

<section class="dsec" id="servicios-dk">
    <div class="wrap">
        <div class="dk-head">
            <div>
                <span class="eyebrow">{t.etiqueta}</span>
                <h2>
                    {t.t1}
                    <br />
                    {t.t2}
                </h2>
            </div>
            <p>{t.texto}</p>
        </div>
        <Rows />
        <p style="margin-top:28px">
            <a class="btn gold" href={ruta("simulador", lang)}>
                {t.simulador}
            </a>
        </p>
    </div>
</section>
