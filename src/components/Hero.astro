---
import VideoPortada from "./VideoPortada.astro";
import Desliza from "./Desliza.astro";
import SiluetaCiudad from "./SiluetaCiudad.astro";
import { langDe, ruta, useT } from "../i18n";
const lang = langDe(Astro.url.pathname);
const t = useT(lang).inicio.hero;
const m = useT(lang).inicio.manifiesto;

// Vídeo de portada (opcional): si existe src/assets/video/hero.mp4 (o .webm) se usa de fondo.
// El póster es src/assets/photos/hero-poster.(jpg|png|webp) y también es opcional.
const videos = import.meta.glob<string>("../assets/video/hero.{mp4,webm}", {
    eager: true,
    query: "?url",
    import: "default",
});
const posters = import.meta.glob<string>(
    "../assets/photos/hero-poster.{jpg,jpeg,png,webp}",
    {
        eager: true,
        query: "?url",
        import: "default",
    },
);
const video = Object.entries(videos)[0];
const poster = Object.values(posters)[0];
const tipo = video?.[0].endsWith(".webm") ? "video/webm" : "video/mp4";

// Barrotes de la balconada del edificio de la ciudad
const balcon = Array.from({ length: 10 }, (_, i) => 674 + i * 6);
---

<section
    class:list={["tdhero", "scene", { "has-video": !!video }]}
    aria-labelledby="hero-title"
>
    {
        video && (
            <div class="herovid" aria-hidden="true">
                <video
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={poster}
                >
                    <source src={video[1]} type={tipo} />
                </video>
            </div>
        )
    }
    <div class="skybg" aria-hidden="true"></div>
    <div class="layer sun" data-depth="sun" aria-hidden="true"></div>
    <div class="hero-copy">
        <!-- Sello: silueta real del archipiélago (public/img/archipielago.png) y «Canarias» -->
        <span class="eyebrow hero-sello" data-fade>
            <img src="/img/archipielago.png" alt="" width="320" height="128" />
            {t.eyebrow}
        </span>
        <h1 id="hero-title">
            <span class="line">
                <span>{t.l1}</span>
            </span>
            <span class="line">
                <span>
                    <em>{t.l2}</em>
                </span>
            </span>
        </h1>
        <p class="hero-claim" data-fade>
            {t.claim.a} <em>{t.claim.b}</em> {t.claim.c}
        </p>
        <p class="sub" data-fade>
            {t.sub}
        </p>
        <!-- Tres garantías con cifra -->
        <ul class="hero-gar" data-fade>
            {
                t.garantias.map((g) => (
                    <li>
                        <b>{g.n}</b> {g.t}
                    </li>
                ))
            }
        </ul>
        <div class="btns" data-fade style="margin-top:6px">
            <a class="btn gold" href={ruta("contacto", lang)}>
                {t.pedir}
            </a>
        </div>
        <!-- Vídeo: tarjeta vertical a la derecha en escritorio; en móvil y tableta, fila bajo el botón -->
        <div class="hero-video" data-fade>
            <VideoPortada tarjeta />
        </div>
    </div>
    <div class="layer city" data-depth="city" aria-hidden="true">
        <svg viewBox="0 -190 1600 390" preserveAspectRatio="xMidYMax slice">
            <!-- En pantallas muy anchas la ciudad no crece: se completa con su reflejo a cada lado -->
            <g transform="scale(-1 1)"><SiluetaCiudad /></g>
            <g transform="translate(3200 0) scale(-1 1)"><SiluetaCiudad /></g>
            <SiluetaCiudad />
        </svg>
    </div>
    <div class="wm" aria-hidden="true">
        <b>
            CABRERA
            <br />
            KAPITAL
        </b>
        <small>{t.lema}</small>
    </div>
    <div class="sky">
        <div class="sky-in">
            <span class="eyebrow dk">{m.etiqueta}</span>
            <p class="manif-t" data-skywords>
                {m.texto}
            </p>
        </div>
    </div>
    <Desliza />
</section>
