---
import { contacto } from "../data/contacto";
import { langDe, useT } from "../i18n";
const lang = langDe(Astro.url.pathname);
const t = useT(lang).mapa;
const src = `https://www.google.com/maps?q=${encodeURIComponent(contacto.mapaConsulta)}&hl=${lang}&z=17&output=embed`;
---

<div class="mapa-caja">
    <div class="mapa" data-mapa data-src={src} data-titulo={t.titulo}>
        <div class="mapa-in">
            <svg
                viewBox="0 0 24 24"
                width="40"
                height="40"
                aria-hidden="true"
                fill="currentColor"
            >
                <path
                    d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
                ></path>
            </svg>
            <b>{contacto.direccionCorta}</b>
            <button class="btn gold" type="button" data-mapa-btn>
                {t.cargar}
            </button>
            <small>{t.nota}</small>
        </div>
    </div>
    <a
        class="mapa-link"
        href={contacto.mapaEnlace}
        target="_blank"
        rel="noopener noreferrer"
    >
        {t.abrir} →
    </a>
</div>
