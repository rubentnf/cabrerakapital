---
import { langDe, useT } from "../i18n";
const t = useT(langDe(Astro.url.pathname)).inicio.pasos;
/* const imgs = ["s2", "s3", "s1"]; */
const imgs = ["p1", "p2", "p3"];
---

<section class="chev" id="chev">
    <div class="wrap">
        <span class="eyebrow dk">{t.etiqueta}</span>
        <h2 class="serif">{t.titulo}</h2>
        <div class="chevs" aria-hidden="true">
            {
                imgs.map((s, i) => (
                    <i class="cv" style={`--img:var(--${s})`}>
                        <b>{i + 1}</b>
                    </i>
                ))
            }
        </div>
        <div class="csteps">
            {
                t.lista.map((p) => (
                    <div class="cs">
                        <h3>{p.t}</h3>
                        <p>{p.d}</p>
                        <span class="pill">{p.p}</span>
                    </div>
                ))
            }
        </div>
    </div>
</section>
