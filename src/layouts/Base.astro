---
import "../styles/base.css";
import "../styles/scroll-story.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Whatsapp from "../components/Whatsapp.astro";
import DatosNegocio from "../components/DatosNegocio.astro";
import AvisoCookies from "../components/AvisoCookies.astro";
import { Font, getImage } from "astro:assets";
import { fotos } from "../utils/assets";
import { langDe, langs, ruta, useT, type PaginaId } from "../i18n";

interface Props {
    title: string;
    description: string;
    page?: PaginaId;
    /** Direcciones de esta página en cada idioma, si no coinciden con las de `page` (por ejemplo, textos legales). */
    alt?: { es: string; en: string };
    /** false: no carga GSAP ni las animaciones (por ejemplo, textos legales). */
    animaciones?: boolean;
    indexable?: boolean;
    /** Ruta canónica, si no es la de la propia página (p. ej. textos legales en inglés → versión española). */
    canonical?: string;
    /** false: no se publican etiquetas hreflang (páginas sin traducción real). */
    hreflang?: boolean;
}

const {
    title,
    description,
    page,
    alt,
    animaciones = true,
    canonical: canonicalRuta,
    hreflang = true,
    indexable = true,
} = Astro.props;

const lang = langDe(Astro.url.pathname);
const t = useT(lang);
const site = Astro.site ?? "https://cabrerakapital.es";
const canonical = new URL(canonicalRuta ?? Astro.url.pathname, site);
const alts = alt ?? {
    es: ruta(page ?? "inicio", "es"),
    en: ruta(page ?? "inicio", "en"),
};
const indexar = import.meta.env.PUBLIC_INDEXAR === "true";

// Estadísticas con Umami (sin cookies): solo se cargan si está definido PUBLIC_UMAMI_ID.
// PUBLIC_UMAMI_SRC permite usar un Umami propio en lugar de Umami Cloud.
const umamiId = import.meta.env.PUBLIC_UMAMI_ID;
const umamiSrc =
    import.meta.env.PUBLIC_UMAMI_SRC || "https://cloud.umami.is/script.js";

// Imagen al compartir en redes y WhatsApp: la foto de la oficina recortada a 1200×630.
// Para usar un diseño propio, sustituirla por una imagen en public/ (por ejemplo "/og.jpg").
const og = await getImage({
    src: fotos.get("oficina")!,
    width: 1200,
    height: 630,
    fit: "cover",
    format: "jpg",
});
---

<!doctype html>
<html lang={t.htmlLang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <Font cssVariable="--font-manrope" preload={[{ style: "normal" }]} />
        <Font cssVariable="--font-newsreader" preload={[{ style: "normal" }]} />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0a2240" />
        <script is:inline>
            // Modo claro/oscuro antes de pintar (evita el destello): elección guardada o la del sistema.
            // El botón y los cambios posteriores están en src/scripts/tema.ts.
            (function () {
                var t = null;
                try {
                    t = localStorage.getItem("tema");
                } catch (e) {}
                if (t !== "light" && t !== "dark")
                    t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                document.documentElement.dataset.theme = t;
                if (t === "dark")
                    document.querySelector('meta[name="theme-color"]').content = "#08142a";
            })();
        </script>
        <link rel="canonical" href={canonical} />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        {
            hreflang && (
                <>
                    {langs.map((l) => (
                        <link
                            rel="alternate"
                            hreflang={l}
                            href={new URL(alts[l], site)}
                        />
                    ))}
                    <link
                        rel="alternate"
                        hreflang="x-default"
                        href={new URL(alts.es, site)}
                    />
                </>
            )
        }
        <meta
            name="robots"
            content={indexar && indexable ? "index,follow" : "noindex,nofollow"}
        />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:locale" content={t.ogLocale} />
        <meta property="og:site_name" content="Cabrera Kapital" />
        <meta property="og:image" content={new URL(og.src, site)} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={t.inicio.oficina.alt} />
        <DatosNegocio imagen={new URL(og.src, site).href} />
        <meta name="twitter:card" content="summary_large_image" />
        {
            umamiId && (
                <script
                    is:inline
                    defer
                    src={umamiSrc}
                    data-website-id={umamiId}
                    data-domains="cabrerakapital.es,www.cabrerakapital.es"
                />
            )
        }
        <slot name="head" />
        <link rel="icon" href="/favicon.png" type="image/png" />
        <script is:inline>
            if (matchMedia("(prefers-reduced-motion: reduce)").matches)
                document.documentElement.classList.add("rm");
        </script>
    </head>
    <body data-sin-animaciones={animaciones ? undefined : ""}>
        <div class="prog" aria-hidden="true"></div>
        <Header page={page} alts={alts} />
        <main>
            <slot />
        </main>
        <Footer />
        <Whatsapp />
        <AvisoCookies />
        <script>
            import "../scripts/main";
        </script>
    </body>
</html>
